---
// Static app icon tile. Same artwork as public/icon.svg, without the Apple template margin.
interface Props {
  size: string;
}

const { size } = Astro.props;
---

<span class="tile" style={`width:${size};height:${size}`} aria-hidden="true">
  <svg viewBox="0 0 1024 1024">
    <rect width="1024" height="1024" fill="#000000"></rect>
    <path
      d="M128 0V1024M256 0V1024M384 0V1024M512 0V1024M640 0V1024M768 0V1024M896 0V1024M0 128H1024M0 256H1024M0 384H1024M0 512H1024M0 640H1024M0 768H1024M0 896H1024"
      stroke="#262626"
      stroke-width="4"
      fill="none"></path>
    <path
      d="M704 288C560 224 336 272 336 416C336 560 688 464 688 624C688 784 448 816 320 736"
      stroke="#ffffff"
      stroke-width="84"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"></path>
  </svg>
</span>
